#!/bin/sh
# hive: the Hive's commands for the person at the console.
#
#   hive ajustes [PAGE]   the machine's settings on the Hive's screen (the
#                         Ajustes app, /usr/share/quantum-os/apps/ajustes,
#                         through `quantum pixel`), as the user who runs it
#   hive apps             the applications installed with the Hive
#
# Every app is a Quantum project folder under /usr/share/quantum-os/apps;
# `hive NAME` opens it on the screen the same way. Reading is the app's;
# a change goes through the Hive and its whitelist.
set -eu

APPS=${QUANTUM_OS_APPS:-/usr/share/quantum-os/apps}

usage() {
    echo "hive: the Hive's commands" >&2
    echo "  hive ajustes [PAGE]   the machine's settings on the screen" >&2
    echo "  hive apps             the applications installed with the Hive" >&2
    exit 2
}

[ $# -ge 1 ] || usage
cmd=$1
shift
case $cmd in
    apps)
        for d in "$APPS"/*/; do
            [ -f "$d/quantum.config.yaml" ] && basename "$d"
        done
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        app="$APPS/$cmd"
        if [ ! -f "$app/quantum.config.yaml" ]; then
            echo "hive: no app named $cmd in $APPS (hive apps lists them)" >&2
            exit 1
        fi
        cd "$app"
        exec quantum pixel "$@"
        ;;
esac
