// a real process holds a port and a unit retrying to bind it fails every second: the real network
// nerve names both, once; listing the ports, once approved, is run by the real actuator
{"op": "start"}
{"op": "sh", "sh": "systemd-run --unit=lab-holder python3 -m http.server 8080 --bind 0.0.0.0"}
{"op": "until_sh", "sh": "ss -tlnH 'sport = :8080'", "contains": "8080"}
{"op": "put", "path": "/usr/local/sbin/nginx", "mode": "755", "text": "#!/bin/sh\n# the VM lab's stand-in for nginx: fails while /run/lab/broken exists\nif [ -e /run/lab/broken ]; then\n    echo 'nginx: [emerg] bind() to 0.0.0.0:8080 failed (98: Address already in use)' >&2\n    exit 1\nfi\nexec sleep infinity\n"}
{"op": "put", "path": "/etc/systemd/system/nginx.service", "text": "[Unit]\nDescription=the VM lab's stand-in for nginx\nStartLimitIntervalSec=0\n\n[Service]\nExecStart=/usr/local/sbin/nginx\nRestart=on-failure\nRestartSec=1\n"}
{"op": "sh", "sh": "mkdir -p /run/lab && touch /run/lab/broken && systemctl daemon-reload"}
{"op": "tui", "app": "dashboard", "rows": 30, "cols": 110}
{"op": "until_screen", "app": "dashboard", "contains": "Waiting for Hive activity"}
{"op": "sh", "sh": "systemctl start nginx"}
{"op": "until_journal", "unit": "hive-nerve-network.service", "contains": "Reported port conflict on port 8080"}
{"op": "until_screen", "app": "dashboard", "contains": "Port Conflict Detected", "timeout": 15}
{"op": "until_screen", "app": "dashboard", "contains": "Hive Suggestion — Show listening ports", "timeout": 15}
{"op": "until_sh", "sh": "test $(systemctl show -p NRestarts --value nginx) -ge 4", "timeout": 30}
{"op": "until_screen", "app": "dashboard", "contains": "Port Conflict Detected", "count": 1}
{"op": "keys_until", "app": "dashboard", "keys": ["Down"], "contains": "See which process is holding port 8080"}
{"op": "keys", "app": "dashboard", "keys": ["Enter"]}
{"op": "until_journal", "unit": "hive-actuator.service", "contains": "ss", "timeout": 20}
{"op": "until_screen", "app": "dashboard", "contains": "Show listening ports (done)", "timeout": 20}
{"op": "end"}
