// the Brazilian keyboard on the real screen: the system says br in /etc/default/keyboard, the daemon reads it at
// start, and a page typed into from the real keyboard gets ç from its own key and ã from the dead ~ and the a after
// it: the form comes back to the user's program with "ação"
{"op": "start"}
{"op": "until_sh", "sh": "systemctl is-active hive-screen", "timeout": 20}
{"op": "put", "path": "/etc/default/keyboard", "text": "XKBMODEL=\"abnt2\"\nXKBLAYOUT=\"br\"\nXKBVARIANT=\"\"\nXKBOPTIONS=\"\"\nBACKSPACE=\"guess\"\n"}
{"op": "sh", "sh": "systemctl restart hive-screen"}
{"op": "until_journal", "unit": "hive-screen.service", "contains": "keyboard layout br (ABNT2)", "timeout": 15}
{"op": "until_shot", "has": "#ffd34d", "timeout": 15}
{"op": "put", "path": "/tmp/pixel-client.py", "mode": "644", "text": "import json, socket\ns = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)\ns.connect('/run/hive-screen/pixel.sock')\npage = {'title': 'Tarefas', 'view': [{'id': 1, 'type': 'form', 'event': {'action': 'criar', 'fields': {}}, 'children': [{'id': 2, 'type': 'input', 'props': {'bind': 'titulo'}}, {'id': 3, 'type': 'button', 'props': {'text': 'Criar'}}]}]}\ns.sendall((json.dumps({'op': 'show', 'page': page}) + '\\n').encode())\nwith open('/tmp/pixel-events.log', 'a') as log:\n    for line in s.makefile('r'):\n        log.write(line)\n        log.flush()\n        if json.loads(line).get('event') == 'close':\n            break\n"}
{"op": "sh", "sh": "rm -f /tmp/pixel-events.log; nohup python3 /tmp/pixel-client.py >/tmp/pixel-client.out 2>&1 &", "user": "druid"}
{"op": "until_shot", "has": "#121228", "min": 20000, "timeout": 15}
{"op": "press", "keys": ["a", "semicolon", "apostrophe", "a", "o", "enter"]}
{"op": "until_sh", "sh": "cat /tmp/pixel-events.log", "contains": "\"titulo\":\"ação\"", "timeout": 10}
{"op": "press", "keys": ["escape"]}
{"op": "until_shot", "lacks": "#121228", "timeout": 15}
{"op": "end"}
