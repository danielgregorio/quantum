// an app cannot bind port 80 because nginx holds it: the shell is told who holds it, and the Hive offers to list the ports
{"op":"start"}
{"op":"port_conflict","port":80,"requested_by":"app","held_by":"nginx"}
{"op":"until","to":"shell","type":"Notification","contains":"app could not bind port 80: already held by nginx"}
{"op":"until","to":"dashboard","type":"Notification","contains":"lsof -i :80","excludes":"SERVICE","timeout":10}
{"op":"end"}
