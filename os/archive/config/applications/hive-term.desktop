[Desktop Entry]
Type=Application
Name=Hive Terminal
Comment=DruidOS Terminal with Hive integration
GenericName=Terminal Emulator
Exec=hive-term
Icon=utilities-terminal
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;console;command line;shell;hive;
StartupNotify=true
Actions=new-window;anonymous;

[Desktop Action new-window]
Name=New Window
Exec=hive-term

[Desktop Action anonymous]
Name=Anonymous Mode
Exec=env HIVE_ANONYMOUS=full hive-term
