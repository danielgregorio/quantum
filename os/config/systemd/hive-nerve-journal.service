[Unit]
Description=DruidOS Hive Nerve - Journal Observer
Documentation=https://druidos.org/docs/hive-nerve-journal
After=hive-cortex.service systemd-journald.service
Requires=hive-cortex.service
PartOf=hive-cortex.service

[Service]
Type=notify
ExecStart=/usr/bin/hive-nerve-journal
Restart=always
RestartSec=5

# Read-only access user
User=_hive-sense
Group=hive
SupplementaryGroups=systemd-journal

# Environment
Environment=RUST_LOG=info
Environment=HIVE_CONFIG=/etc/hive/config.toml

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Minimal capabilities
CapabilityBoundingSet=

# Read access to journal
ReadOnlyPaths=/run/log/journal /var/log/journal /run/hive

# System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount

[Install]
WantedBy=multi-user.target
