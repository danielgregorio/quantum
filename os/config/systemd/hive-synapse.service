[Unit]
Description=DruidOS Hive Synapse - SLM Inference Engine
Documentation=https://druidos.org/docs/hive-synapse
After=hive-cortex.service
Requires=hive-cortex.service
PartOf=hive-cortex.service

[Service]
Type=notify
ExecStart=/usr/bin/hive-synapse
Restart=always
RestartSec=5

# Dedicated user with minimal privileges
User=_hive-ai
Group=hive

# Environment
Environment=RUST_LOG=info
Environment=HIVE_CONFIG=/etc/hive/config.toml

# Model storage
StateDirectory=hive/models
StateDirectoryMode=0750

# Heavy security isolation
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
# Needed for model inference. (systemd has no inline comments: a trailing
# "# ..." on the value line makes the whole line unparseable and ignored.)
MemoryDenyWriteExecute=no

# System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Capabilities
CapabilityBoundingSet=

# Resource limits
MemoryMax=2G
CPUQuota=200%

# Only needs access to cortex socket
ReadOnlyPaths=/run/hive

[Install]
WantedBy=multi-user.target
