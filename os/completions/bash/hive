# hive-dock completion
_hive_dock() {
    local cur prev opts cmds
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    cmds="show hide toggle reload pin unpin"
    opts="--help --version --config --position"

    case "${prev}" in
        --config|-c)
            COMPREPLY=( $(compgen -f -- "${cur}") )
            return 0
            ;;
        --position|-p)
            COMPREPLY=( $(compgen -W "bottom top left right" -- "${cur}") )
            return 0
            ;;
        pin|unpin)
            # Complete with .desktop files
            COMPREPLY=( $(compgen -W "$(ls /usr/share/applications/*.desktop 2>/dev/null | xargs -n1 basename .desktop)" -- "${cur}") )
            return 0
            ;;
    esac

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${cmds}" -- "${cur}") )
    else
        COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    fi
}
complete -F _hive_dock hive-dock

