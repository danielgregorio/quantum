#compdef hive-cortex hive-synapse hive-apt hive-zfs hive-shell hive-term hive-dock hive-actuator

# Zsh completion for DruidOS Hive Stack commands
# Place in a directory in your $fpath (e.g., /usr/share/zsh/site-functions/)

_hive-cortex() {
    local -a opts
    opts=(
        '(-h --help)'{-h,--help}'[Show help message]'
        '(-V --version)'{-V,--version}'[Show version]'
        '(-c --config)'{-c,--config}'[Configuration file]:config file:_files'
        '(-l --log-level)'{-l,--log-level}'[Log level]:level:(trace debug info warn error)'
        '(-f --foreground)'{-f,--foreground}'[Run in foreground]'
        '(-s --socket)'{-s,--socket}'[Socket path]:socket:_files'
    )
    _arguments -s $opts
}

_hive-synapse() {
    local -a opts
    opts=(
        '(-h --help)'{-h,--help}'[Show help message]'
        '(-V --version)'{-V,--version}'[Show version]'
        '(-c --config)'{-c,--config}'[Configuration file]:config file:_files'
        '(-m --model)'{-m,--model}'[Model file (GGUF)]:model file:_files -g "*.gguf"'
        '--context-size[Context window size]:size:(512 1024 2048 4096)'
        '--max-tokens[Maximum tokens to generate]:tokens:'
        '--temperature[Generation temperature]:temp:'
        '--test-model[Test model loading]:model file:_files -g "*.gguf"'
    )
    _arguments -s $opts
}

_hive-apt() {
    local -a commands opts

    commands=(
        'install:Install packages'
        'remove:Remove packages'
        'update:Update package lists'
        'upgrade:Upgrade packages'
        'search:Search for packages'
        'show:Show package details'
        'info:Show package information'
        'autoremove:Remove unused dependencies'
        'clean:Clean package cache'
    )

    opts=(
        '(-h --help)'{-h,--help}'[Show help message]'
        '(-V --version)'{-V,--version}'[Show version]'
        '(-y --yes)'{-y,--yes}'[Assume yes to prompts]'
        '--no-snapshot[Skip ZFS snapshot]'
        '(-q --quiet)'{-q,--quiet}'[Quiet mode]'
    )

    _arguments -s \
        '1:command:->command' \
        '*:package:->packages' \
        $opts

    case $state in
        command)
            _describe -t commands 'hive-apt commands' commands
            ;;
        packages)
            case ${words[2]} in
                install|remove|show|info)
                    _deb_packages
                    ;;
            esac
            ;;
    esac
}

_hive-zfs() {
    local -a commands opts datasets

    commands=(
        'snapshot:Create a snapshot'
        'rollback:Rollback to a snapshot'
        'list:List snapshots'
        'destroy:Destroy a snapshot'
        'clean:Clean old snapshots'
        'status:Show ZFS status'
    )

    opts=(
        '(-h --help)'{-h,--help}'[Show help message]'
        '(-V --version)'{-V,--version}'[Show version]'
        '(-d --dataset)'{-d,--dataset}'[Dataset name]:dataset:->datasets'
        '(-r --recursive)'{-r,--recursive}'[Recursive operation]'
        '(-k --keep)'{-k,--keep}'[Number of snapshots to keep]:count:(1 3 5 7 10 14 30)'
        '(-o --older-than)'{-o,--older-than}'[Remove older than]:age:(1d 7d 14d 30d 90d)'
    )

    _arguments -s \
        '1:command:->command' \
        '*:dataset:->datasets' \
        $opts

    case $state in
        command)
            _describe -t commands 'hive-zfs commands' commands
            ;;
        datasets)
            if (( $+commands[zfs] )); then
                datasets=( ${(f)"$(zfs list -H -o name 2>/dev/null)"} )
                _describe -t datasets 'ZFS datasets' datasets
            fi
            ;;
    esac
}

_hive-shell() {
    local -a commands opts

    commands=(
        'toggle:Toggle overlay visibility'
        'show:Show overlay'
        'hide:Hide overlay'
        'quiet:Enter quiet mode'
        'detach:Detach current terminal'
        'full:Enter full anonymous mode'
        'test-notification:Send test notification'
        'status:Show current status'
    )

    opts=(
        '(-h --help)'{-h,--help}'[Show help message]'
        '(-V --version)'{-V,--version}'[Show version]'
        '(-c --config)'{-c,--config}'[Configuration file]:config file:_files'
    )

    _arguments -s \
        '1:command:->command' \
        $opts

    case $state in
        command)
            _describe -t commands 'hive-shell commands' commands
            ;;
    esac
}

_hive-term() {
    local -a opts

    opts=(
        '(-h --help)'{-h,--help}'[Show help message]'
        '(-V --version)'{-V,--version}'[Show version]'
        '(-c --config)'{-c,--config}'[Configuration file]:config file:_files'
        '(-e --command)'{-e,--command}'[Command to execute]:command:_command_names'
        '(-d --working-directory)'{-d,--working-directory}'[Working directory]:directory:_directories'
        '(-a --anonymous)'{-a,--anonymous}'[Anonymous mode]:level:(quiet detach full)'
        '--class[Window class]:class:'
        '--title[Window title]:title:'
    )

    _arguments -s $opts
}

_hive-dock() {
    local -a commands opts

    commands=(
        'show:Show dock'
        'hide:Hide dock'
        'toggle:Toggle dock visibility'
        'reload:Reload configuration'
        'pin:Pin application'
        'unpin:Unpin application'
    )

    opts=(
        '(-h --help)'{-h,--help}'[Show help message]'
        '(-V --version)'{-V,--version}'[Show version]'
        '(-c --config)'{-c,--config}'[Configuration file]:config file:_files'
        '(-p --position)'{-p,--position}'[Dock position]:position:(bottom top left right)'
    )

    _arguments -s \
        '1:command:->command' \
        '*:app:->apps' \
        $opts

    case $state in
        command)
            _describe -t commands 'hive-dock commands' commands
            ;;
        apps)
            case ${words[2]} in
                pin|unpin)
                    local -a apps
                    apps=( ${(f)"$(ls /usr/share/applications/*.desktop 2>/dev/null | xargs -n1 basename .desktop)"} )
                    _describe -t apps 'Applications' apps
                    ;;
            esac
            ;;
    esac
}

_hive-actuator() {
    local -a opts

    opts=(
        '(-h --help)'{-h,--help}'[Show help message]'
        '(-V --version)'{-V,--version}'[Show version]'
        '(-c --config)'{-c,--config}'[Configuration file]:config file:_files'
        '(-w --whitelist)'{-w,--whitelist}'[Whitelist file]:whitelist:_files'
        '(-n --dry-run)'{-n,--dry-run}'[Dry run mode]'
        '(-l --log-level)'{-l,--log-level}'[Log level]:level:(trace debug info warn error)'
    )

    _arguments -s $opts
}

# Dispatch to the right completion function based on the command
case $service in
    hive-cortex)  _hive-cortex ;;
    hive-synapse) _hive-synapse ;;
    hive-apt)     _hive-apt ;;
    hive-zfs)     _hive-zfs ;;
    hive-shell)   _hive-shell ;;
    hive-term)    _hive-term ;;
    hive-dock)    _hive-dock ;;
    hive-actuator) _hive-actuator ;;
esac
