# DruidOS Minimal Kernel Configuration
# Target: ~50 modules, VirtIO-only, VM-first
# Base: Linux 6.12+
#
# Usage:
#   make tinyconfig
#   scripts/kconfig/merge_config.sh .config druidos.config
#   make -j$(nproc)

#=============================================================================
# GENERAL SETUP
#=============================================================================

CONFIG_LOCALVERSION="-druidos"
CONFIG_DEFAULT_HOSTNAME="druidos"

# 64-bit kernel
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256

# Preemption model (desktop responsiveness)
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Kernel compression
CONFIG_KERNEL_ZSTD=y

# No initrd required (we boot directly to rootfs)
# CONFIG_BLK_DEV_INITRD is not set

# Module support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y

# Disable kernel live patching (VM can just reboot)
# CONFIG_LIVEPATCH is not set

#=============================================================================
# PROCESSOR TYPE
#=============================================================================

# Generic x86-64 for VM compatibility
CONFIG_GENERIC_CPU=y

# Disable physical CPU features we don't need in VM
# CONFIG_X86_MCE is not set
# CONFIG_MICROCODE is not set
# CONFIG_X86_5LEVEL is not set

# Keep NUMA for large VMs
CONFIG_NUMA=y
CONFIG_AMD_NUMA=y
CONFIG_X86_64_ACPI_NUMA=y

#=============================================================================
# POWER MANAGEMENT (Minimal - VM handles this)
#=============================================================================

CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
# CONFIG_ACPI_FAN is not set
# CONFIG_ACPI_THERMAL is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_HIBERNATION is not set
CONFIG_SUSPEND=y

#=============================================================================
# VIRTUALIZATION GUEST SUPPORT
#=============================================================================

CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_SPINLOCKS=y
CONFIG_KVM_GUEST=y
CONFIG_ARCH_CPUIDLE_HALTPOLL=y
CONFIG_PARAVIRT_TIME_ACCOUNTING=y

#=============================================================================
# VIRTIO CORE (The Heart of DruidOS)
#=============================================================================

CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_MODERN=y
CONFIG_VIRTIO_PCI_MODERN_DEV=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_MEM=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_IOMMU=y

#=============================================================================
# BLOCK DEVICES
#=============================================================================

CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_LOOP_MIN_COUNT=8

# VirtIO Block (primary storage)
CONFIG_VIRTIO_BLK=y

# No physical disk controllers
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_BLK_DEV_NVME is not set

#=============================================================================
# NETWORKING
#=============================================================================

CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_NET_IPGRE=m
CONFIG_NET_IPGRE_DEMUX=m
CONFIG_SYN_COOKIES=y

# IPv6
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# Netfilter (for containers/firewalling)
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_NAT=m

# Bridge (for containers)
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_VETH=m

# VSOCK (VM sockets for host communication)
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m

#=============================================================================
# NETWORK DRIVERS
#=============================================================================

CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y

# VirtIO Network (primary)
CONFIG_VIRTIO_NET=y

# No physical NICs
# CONFIG_ETHERNET is not set
# CONFIG_WLAN is not set

# Loopback and TUN/TAP
CONFIG_DUMMY=m
CONFIG_TUN=m
CONFIG_VXLAN=m

#=============================================================================
# INPUT DEVICES
#=============================================================================

CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y

# VirtIO handles input in VMs
# CONFIG_INPUT_EVDEV is set by VIRTIO_INPUT

#=============================================================================
# GRAPHICS / FRAMEBUFFER
#=============================================================================

CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y

# VirtIO GPU (primary graphics)
CONFIG_DRM_VIRTIO_GPU=y

# Fallback: Simple framebuffer for basic console
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VGA_CONSOLE=y

# No physical GPUs
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_RADEON is not set

#=============================================================================
# CONSOLE / TTY
#=============================================================================

CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_HW_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n

# VirtIO Console
CONFIG_VIRTIO_CONSOLE=y

# Serial console (for debugging)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

#=============================================================================
# SOUND (Minimal - VirtIO)
#=============================================================================

CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_VIRTIO=m

# No physical sound cards
# CONFIG_SND_HDA_INTEL is not set
# CONFIG_SND_USB_AUDIO is not set

#=============================================================================
# USB (Guest side only)
#=============================================================================

CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y

# USB device passthrough from host
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_HID=m

#=============================================================================
# FILESYSTEMS
#=============================================================================

# Root filesystem options
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# XFS as alternative
CONFIG_XFS_FS=m
CONFIG_XFS_POSIX_ACL=y

# BTRFS for those who prefer it
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y

# ZFS loaded as out-of-tree module (OpenZFS)
# Requires: SPL + ZFS DKMS

# Required pseudo-filesystems
CONFIG_PROC_FS=y
CONFIG_PROC_KCORE=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CONFIGFS_FS=y
CONFIG_SECURITYFS=y

# Additional filesystems
CONFIG_FUSE_FS=m
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_ZSTD=y

# VirtIO Filesystem (9p replacement, high performance)
CONFIG_VIRTIO_FS=m

# UEFI boot
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y

#=============================================================================
# SECURITY
#=============================================================================

CONFIG_SECURITY=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_NETWORK=y

# AppArmor (Ubuntu default)
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y

# Capabilities
CONFIG_SECURITY_SELINUX=n

# Hardening
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

#=============================================================================
# CGROUPS & NAMESPACES (Required for systemd and containers)
#=============================================================================

CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_MISC=y

# cgroups v2 (unified hierarchy)
CONFIG_CGROUP_V2=y

# Namespaces
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

#=============================================================================
# SYSTEMD REQUIREMENTS
#=============================================================================

CONFIG_DEVTMPFS=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_NET=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_FHANDLE=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_DMIID=y
CONFIG_BLK_DEV_BSG=y
CONFIG_NET_NS=y

# Required for journald
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# systemd-boot
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=n

#=============================================================================
# RANDOM NUMBER GENERATION
#=============================================================================

CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RANDOM_TRUST_CPU=y

#=============================================================================
# CRYPTO (Minimal for systemd + networking)
#=============================================================================

CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32=y
CONFIG_CRYPTO_XXHASH=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZO=y

#=============================================================================
# DEBUG (Minimal for production, can enable for dev)
#=============================================================================

# Disable most debug options for size/performance
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_KPROBES is not set

# Keep dmesg and sysrq for troubleshooting
CONFIG_PRINTK=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=1

#=============================================================================
# DISABLED SUBSYSTEMS (Not needed in VMs)
#=============================================================================

# No wireless
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_MAC80211 is not set

# No Bluetooth
# CONFIG_BT is not set

# No physical sensors
# CONFIG_HWMON is not set

# No physical CPU frequency scaling
# CONFIG_CPU_FREQ is not set

# No laptop features
# CONFIG_ACPI_VIDEO is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set

# No physical media
# CONFIG_CDROM is not set

# No legacy buses
# CONFIG_ISA is not set
# CONFIG_ISAPNP is not set

# No Thunderbolt
# CONFIG_THUNDERBOLT is not set

# No GPIO (physical)
# CONFIG_GPIOLIB is not set
